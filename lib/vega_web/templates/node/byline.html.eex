<p class="text-sm text-slate-500 mb-6">
  By
  <%= link(@node.user.fullname, to: Routes.page_path(VegaWeb.Endpoint, :user_detail, @node.user.username), class: "font-medium text-slate-700 hover:text-indigo-600 transition-colors") %>
  <span class="mx-1.5 text-slate-300">&bull;</span>
  <time datetime="<%= NaiveDateTime.to_iso8601(@node.created) %>"><%= VegaWeb.NodeView.dformat_node(@node.created) %></time>
</p>

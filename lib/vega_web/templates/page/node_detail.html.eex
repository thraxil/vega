<nav aria-label="Breadcrumb" class="mb-8">
  <ol role="list" class="flex items-center space-x-2 text-sm text-slate-500">
  <%= render(VegaWeb.BreadcrumbsView, "breadcrumb.html", Map.merge(%{conn: @conn}, Map.new([user: @user, type: @type, year: @year, month: @month, day: @day]))) %>
  </ol>
</nav>

<%= if @current_user do %>
  <div class="flex justify-end mb-4">
    <%= link("Edit this post",
      to: Routes.page_path(@conn, :show_node, @node.id),
      class:
        "inline-flex items-center px-3 py-1.5 border border-slate-300 shadow-sm text-sm font-medium rounded text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
    ) %>
  </div>
<% end %>

<article class="mb-16 md:mb-24">
  <%= render(VegaWeb.NodeView, "node_title.html", Map.merge(%{conn: @conn}, Map.new([node: @node]))) %>
  <%= render(VegaWeb.NodeView, "byline.html", Map.merge(%{conn: @conn}, Map.new([node: @node]))) %>

  <%= render(VegaWeb.NodeView, "node_content.html", Map.merge(%{conn: @conn}, Map.new([node: @node, content: @content]))) %>

  <%= render(VegaWeb.NodeView, "node_tags.html", Map.merge(%{conn: @conn}, Map.new([node: @node]))) %>

  <%= if length(@node.comments) > 0 do %>
    <section class="mt-16 pt-8 border-t border-slate-100">
      <h3 class="text-xl font-bold text-slate-900 mb-8">Comments</h3>

      <div class="space-y-8">
        <%= for comment <- @node.comments do %>
          <div class="bg-slate-50 rounded-lg p-6">
            <div class="flex items-center mb-4">
              <span class="font-semibold text-slate-900"><%= comment.author_name %></span>
              <span class="mx-2 text-slate-300">&bull;</span>
              <time class="text-sm text-slate-500"><%= comment.created %></time>
            </div>
            <div class="prose max-w-none text-sm">
              <%= raw(Earmark.as_html!(comment.body)) %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</article>

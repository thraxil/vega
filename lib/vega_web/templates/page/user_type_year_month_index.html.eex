<nav aria-label="Breadcrumb" class="mb-8">
  <ol role="list" class="flex items-center space-x-2 text-sm text-slate-500">
  <%= render(VegaWeb.BreadcrumbsView, "breadcrumb.html", Map.merge(%{conn: @conn}, Map.new([user: @user, type: @type, year: @year]))) %>
  <%= render(VegaWeb.BreadcrumbsView, "breadcrumb_tail.html", %{title: @month}) %>
  </ol>
</nav>

<div class="prose text-slate-900">
  <ul>
    <%= for d <- @days do %>
      <li>
        <%= link(trunc(d.day),
          to:
            Routes.page_path(
              @conn,
              :user_type_year_month_day_index,
              @user.username,
              @type <> "s",
              @year,
              @month,
              trunc(d.day)
            ),
          class: "text-slate-900"
        ) %> (<%= d.count %>)
      </li>
    <% end %>
  </ul>
</div>
